---
import dateConfig from ".json/date.json";
import config from "@/config/config.json";
import { useEffect } from 'react';

const base = config.site.base_path.replace(`/+$`, "");
// 获取今天的日期并格式化为YYYY-MM-DD格式
const today = new Date();
// const today = new Date('2024-04-18');
const dateString = today.toISOString().split('T')[0];

// 根据今天的日期查找对应的id
const work_id = dateConfig[dateString as keyof typeof dateConfig] || null;
const redirectUrl = work_id ? `${base}/works/${work_id}` : `${base}/404`;
console.log('today, work_id: ', work_id, ' redirectUrl: ', redirectUrl);

// For SSR, we can redirect immediately
if (import.meta.env.SSR) {
  if (!work_id) {
    return Astro.redirect(redirectUrl);
  }

  return Astro.redirect(redirectUrl);
}
---

<!-- Client-side redirect for static builds -->
<html>
  <head>
    <title>Redirecting...</title>
    <script is:inline>
      // Client-side redirect
      window.location.replace('{redirectUrl}');
    </script>
    <meta http-equiv="refresh" content={`0;url=${redirectUrl}`} />
  </head>
  <body>
    <p>Redirecting to today's work... <a href={redirectUrl}>Click here if not redirected</a></p>
  </body>
</html>
