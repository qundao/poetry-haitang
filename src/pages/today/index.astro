---
import dateConfig from ".json/date.json";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";

const base = config.site.base_path.replace(`/+$`, "");
// 获取今天的日期并格式化为YYYY-MM-DD格式
const dateString = (new Date()).toISOString().split("T")[0];

// 根据今天的日期查找对应的id
const work_id = dateConfig[dateString as keyof typeof dateConfig] || null;
const redirectUrl = work_id ? `${base}/works/${work_id}` : `${base}/404`;

const title = "每日一诗" + " - " + config.site.title;
const description = "每日一诗";
const canonical = config.site.base_url + redirectUrl;

// For SSR, we can redirect immediately
// if (import.meta.env.SSR) {
//   if (!work_id) {
//     return Astro.redirect(redirectUrl);
//   }

//   return Astro.redirect(redirectUrl);
// }
---

<Base title={title} description={description} canonical={canonical}>
  <section class="section px-4 pt-0 pb-0 mb-14 mx-auto">
    <div class="container">
      <div class="pt-20 pb-10 grid text-center">
        <p>正在跳转到<strong>{description}</strong>......</p>
        <p>如果浏览器未自动跳转，请点击<a href={redirectUrl}>这里</a></p>
      </div>
    </div>
  </section>

  <script
    set:html={`
      const dateToIdMap = ${JSON.stringify(dateConfig)};
      const base = ${JSON.stringify(base)};

      // const dateStr = (new Date()).toISOString().split("T")[0];
      const now = new Date();
      const beijing = new Date(now.toLocaleString("zh-CN", { timeZone: "Asia/Shanghai" }));
      const todayStr = beijing.toISOString().split('T')[0];
      const page = dateToIdMap[todayStr];

      let url = base + '/404';
      if (page) {
        url = base + '/works/' + encodeURIComponent(String(page));
      }

      // console.log('[Today Redirect]', todayStr, page, url);
      // 动态跳转
      window.location.href = url;
    `}
  />
</Base>
